# Demo 2 is local and test-only. Do not use a production database or n8n target.
DATABASE_URL="postgresql://rlb_readonly:replace-with-password@127.0.0.1:15432/prospecting"
PRODUCER_DATABASE_URL="postgresql://prospecta_producer_read:replace-with-password@127.0.0.1:15432/prospecting"
APP_DATABASE_URL="postgresql://prospecta_app_rw:replace-with-password@127.0.0.1:15432/prospecta_app_prod"

AUTH_SECRET="replace-with-a-local-demo-secret-of-at-least-32-characters"
AUTH_OIDC_ISSUER="https://identity.example.com/demo2"
AUTH_OIDC_CLIENT_ID="demo2-local-client"
AUTH_OIDC_CLIENT_SECRET="replace-with-a-local-demo-client-secret"
AUTH_ALLOWED_ORG_ID="demo2-test-organization"
AUTH_DEV_BYPASS_ENABLED="true"
DEMO2_FULL_ACCESS_ENABLED="true"
DEMO2_K8S_RUNTIME_ENABLED="false"

# The approved test ingress. Send synthetic CSVs only.
N8N_IMPORT_URL="http://192.168.0.20:30098/webhook/empresaqui/import"
IMPORT_MAX_BYTES="10485760"
IMPORT_PRODUCER_TIMEOUT_MS="15000"
SENSITIVE_URL_HOSTS=""

# Demo 2 uses only test app/producer databases and the test ingress.
FEATURE_IMPORTS_ENABLED="true"
FEATURE_BATCH_OBSERVATION_ENABLED="true"
FEATURE_COMMERCIAL_ENABLED="true"
FEATURE_SENSITIVE_CONTENT_ENABLED="true"
FEATURE_DEMO_DATA_ENABLED="false"
FEATURE_COSTS_ENABLED="true"
COSTS_READ_SUBJECTS="local-development-user"
PORT="3011"
