# Demo 3 is the exact local, single-tester pre-production target.
# Producer credentials are copied in memory from the identified Kubernetes
# Secret; never add them to this file.
# Copy to .env.demo3.local and replace every placeholder.
DEMO3_EXPECTED_CONTEXT="kubernetes-admin@kubernetes"
DEMO3_EXPECTED_SERVER="https://192.168.0.20:6443"
DEMO3_EXPECTED_CLUSTER_UID="replace-with-kube-system-namespace-uid"
DEMO3_EXPECTED_N8N_NAMESPACE_UID="replace-with-identified-n8n-namespace-uid"
DEMO3_RELEASE_ID="demo3-preprod-20260717-001"

DEMO3_POSTGRES_OWNER_PASSWORD="replace-with-a-local-owner-password-of-at-least-32-characters"
DEMO3_APP_DATABASE_PASSWORD="replace-with-a-distinct-runtime-password-of-at-least-32-characters"
AUTH_SECRET="replace-with-a-local-demo-secret-of-at-least-32-characters"
AUTH_OIDC_CLIENT_SECRET="replace-with-a-local-placeholder-client-secret"
N8N_IMPORT_EVENT_SECRET="replace-with-a-random-event-secret-of-at-least-32-bytes"
N8N_CONTACT_ENRICHMENT_SECRET="replace-with-a-contact-ingress-secret-of-at-least-32-bytes"
N8N_CONTACT_CALLBACK_SECRET="replace-with-a-contact-callback-secret-of-at-least-32-bytes"
# Contact v2 stays disabled until Demo 3 has an HTTPS n8n edge and completed
# controller transparency fields. Do not point it at the plain-HTTP v1 URL.
# Demo 3 derives its v2 ingress, callback, encryption, and suppression material
# from AUTH_SECRET with domain-separated HMAC labels and stores only the derived
# values in the immutable release Secret. This shortcut is not a production
# key-management profile.
FEATURE_CONTACT_DATA_ENABLED="false"
CONTACT_CONTROLLER_LEGAL_NAME=""
CONTACT_CONTROLLER_REGISTRATION=""
CONTACT_PRIVACY_CONTACT=""
