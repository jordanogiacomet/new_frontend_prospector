        "jsCode": "const body = $json.body && typeof $json.body === 'object' && !Array.isArray($json.body) ? $json.body : $json;\nconst invalid = () => ({ json: { valid: false } });\nconst expectedFields = ['cnpj_normalizado', 'company_domain', 'contract_version', 'idempotency_key', 'request_id'];\nconst actualFields = Object.keys(body).sort();\nif (actualFields.length !== expectedFields.length || actualFields.some((field, index) => field !== expectedFields[index])) return invalid();\nconst requestId = body.request_id;\nconst idempotencyKey = body.idempotency_key;\nconst cnpj = body.cnpj_normalizado;\nconst domain = body.company_domain;\nif (body.contract_version !== 'prospecta-contact-enrichment-v1') return invalid();\nif (typeof requestId !== 'string' || !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(requestId)) return invalid();\nif (typeof idempotencyKey !== 'string' || idempotencyKey.trim() !== idempotencyKey || idempotencyKey.length < 1 || idempotencyKey.length > 128) return invalid();\nif (typeof cnpj !== 'string' || !/^[0-9]{14}$/.test(cnpj)) return invalid();\nif (typeof domain !== 'string' || domain !== domain.toLowerCase() || !/^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$/.test(domain)) return invalid();\nreturn { json: { valid: true, contract_version: 'prospecta-contact-enrichment-v1', request_id: requestId, company_domain: domain } };"
