{
  "contractVersion": "prospecta-import-v1",
  "workflowName": "Prospecta - EmpresaAqui Import v1 - Batch Acceptance",
  "webhookPath": "prospecta/empresaqui/import/v1",
  "request": {
    "contentType": "multipart/form-data",
    "binaryField": "arquivo_csv",
    "fields": [
      "arquivo_csv",
      "submission_id",
      "idempotency_key",
      "file_sha256",
      "contract_version"
    ]
  },
  "successResponse": {
    "statusCode": 202,
    "exactFields": [
      "accepted",
      "import_batch_id",
      "message",
      "row_count",
      "source"
    ],
    "importBatchIdPattern": "^ib_[0-9a-f]{64}$",
    "minimumAcceptedRows": 1
  },
  "acceptanceNodeName": "Accept Batch Atomically",
  "responseNodeName": "Respond Durable Acceptance",
  "workerCompletion": {
    "contractVersion": "prospecta-producer-worker-v1",
    "exactFields": [
      "worker_contract_version",
      "import_batch_id",
      "source_row",
      "input_row_id",
      "lead_run_id",
      "idempotency_key",
      "terminal_class"
    ],
    "terminalClasses": [
      "MATERIALIZED",
      "BLOCKED",
      "FAILED"
    ],
    "gateNodeName": "Validate Worker Completion Contract v1"
  },
  "close": {
    "contractVersion": "prospecta-import-v1",
    "reason": "WORKER_ORCHESTRATION_FINISHED",
    "nodeName": "Close Batch Explicitly"
  }
}
